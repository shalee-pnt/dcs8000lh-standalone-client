# Binaires / APK du vendeur (ne pas redistribuer, volumineux)
*.apk

# Captures réseau (contiennent handshakes TLS, tokens, trafic perso)
*.pcap
*.pcapng

# Fichiers de sortie / logs / SDP / infos appareil (tokens, pin, etc.)
*.log
*.sdp
device_info*.json
*_out.txt
*_session*.log

